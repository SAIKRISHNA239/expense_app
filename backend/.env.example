# Copy to .env and fill in for production deployment

ENV=production
DATABASE_URL=postgresql://user:password@host:5432/expense_db

# REQUIRED — generate with: openssl rand -hex 32
SECRET_KEY=your-production-secret-here

# Comma-separated origins (include your app domain + Capacitor)
# CORS_ORIGINS=https://your-app.com,capacitor://localhost,http://localhost

# Production hardening
ENABLE_DOCS=false
ENABLE_SCHEDULER=true
AUTO_CREATE_TABLES=false

# Optional
# ACCESS_TOKEN_EXPIRE_MINUTES=43200
