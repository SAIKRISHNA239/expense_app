# Copy to .env — see docs/DEVELOPMENT.md

# ── Local development (defaults) ─────────────────────────────────────────────
# DATABASE_URL=sqlite:///./dev.db
# ENV=development
# SECRET_KEY=dev-only-change-in-production
# CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
# ENABLE_DOCS=true
# ENABLE_SCHEDULER=true
# AUTO_CREATE_TABLES=true

# ── Production ───────────────────────────────────────────────────────────────
ENV=production
DATABASE_URL=postgresql://user:password@host:5432/expense_db

# REQUIRED — generate with: openssl rand -hex 32
SECRET_KEY=your-production-secret-here

# Comma-separated origins (app domain + Capacitor)
CORS_ORIGINS=https://your-app.com,capacitor://localhost,https://localhost,http://localhost

# Phone LAN testing (example):
# CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://192.168.29.4:5173

ENABLE_DOCS=false
ENABLE_SCHEDULER=true
AUTO_CREATE_TABLES=false

# Optional
# ACCESS_TOKEN_EXPIRE_MINUTES=43200
